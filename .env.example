# cp .env.example .env

########## system
LOG_LEVEL=INFO
# Everyone who may use the desk, as user ids (a-z, 0-9, _ or -), the owner first. The API acts only
# for these (the gateway names the user); the CLI's --user defaults to the first.
ALLOWED_USERS=mat,max

########## db
DB_USER=chancellor
DB_PASSWORD=exchequer_local_pw
DB_NAME=exchequer
DB_PORT=5433
DATABASE_URL=postgresql://chancellor:exchequer_local_pw@localhost:5433/exchequer
# Creates LangGraph's checkpoint tables when the CLI starts (`just chat`, `just research`); locally
# the owner above. Unset, the CLI only checks the tables exist (`just migrate` creates them). On the
# Spark leave it unset: the one-shot `migrate` service has its own.
DATABASE_SETUP_URL=postgresql://chancellor:exchequer_local_pw@localhost:5433/exchequer
DB_POOL_MIN=1
DB_POOL_MAX=10
# Passwords of the two roles the db creates with a new volume (services/db/init/01-app-role.sh);
# URL-safe and random, e.g. `openssl rand -hex 32`. Changing one later also needs
# `ALTER ROLE ... PASSWORD` as the owner. `just up` needs both too.
# lauretta_app: what api and worker connect as; row-level security applies to it.
DB_APP_PASSWORD=
# lauretta_migrator: creates the checkpoint tables in the one-shot `migrate` service only.
DB_MIGRATOR_PASSWORD=

########## agent
# anthropic (needs ANTHROPIC_API_KEY, billed separately from Claude Pro)
# or openai (any OpenAI-compatible server: vLLM, Ollama at http://localhost:11434/v1, ...)
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-5
AGENT_BASE_URL=
AGENT_TEMPERATURE=0
AGENT_MAX_TOKENS=16000
AGENT_TIMEOUT=120
AGENT_RECURSION_LIMIT=40
# Stream the model's reasoning to clients ahead of the answer (compose defaults it to true).
AGENT_STREAM_REASONING=true
# How many times the checker may send a story back before it goes to the advisor as is.
PIPELINE_MAX_REVISIONS=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

########## memory (local CPU embeddings, no key)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIMS=384

########## data
# SEC EDGAR asks every client to identify itself, quoted: SEC_USER_AGENT="Your Name you@example.com"
SEC_USER_AGENT=

# Job queue (API and worker only; the CLI does not use it). Valkey or Redis.
BROKER_URL=redis://127.0.0.1:18479/0
BROKER_MIN_IDLE_MS=60000
BROKER_MAX_DELIVERIES=3
WORKER_CONCURRENCY=4
AGENT_LOCK_WAIT_MS=30000
AGENT_LOCK_TTL_MS=30000
EVENTS_TTL_S=86400
API_MAX_WAIT_S=25
API_MAX_STREAM_S=900
# Voice (the `speech` service; compose sets SPEECH_URL). The models download at its first start.
STT_MODEL=Systran/faster-whisper-small
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# The Director's voice unless the user's tts_voice fact names another Kokoro voice.
TTS_VOICE=af_heart
VOICE_MAX_UPLOAD_BYTES=10000000
# --- Stack on the Spark (docker-compose.yaml; `just up` for local dev needs none of these) ---
# The owner's key for scripts and curl, sent as `Authorization: Bearer <key>`; it always acts as
# the user mat. Long and random. AnythingLLM has its own key below.
GATEWAY_API_KEY=
# AnythingLLM's key to the gateway: it may only list models and chat, and acts as the user its
# workspace's model names (lauretta-mat -> mat, lauretta-max -> max). Random, e.g.
# `openssl rand -hex 32`; never the same as GATEWAY_API_KEY.
ANYTHINGLLM_API_KEY=
# The gateway adds it to every request it sends api, which refuses any other, so no container
# sharing a network with api can forge a user. Random, e.g. `openssl rand -hex 32`.
API_GATEWAY_SECRET=
BROKER_PASSWORD=
# The vllm service's API key; the gateway sends it. Required and random, e.g. `openssl rand -hex 32`.
SPARK_VLLM_API_KEY=
BACKUP_KEEP=14
# Tailscale (the `tailscale` container). OAuth client secret, scope auth_keys, tag:lauretta only;
# never the admin API key. Copied into the Spark's .env at deploy.
TS_OAUTH_SECRET=

# AnythingLLM, the web app at / (and the Android app's pairing server).
# Signs its logins; random, e.g. `openssl rand -hex 32`.
ANYTHINGLLM_JWT_SECRET=
# The password the app asks for until multi-user mode is set up on the first visit; random, e.g.
# `openssl rand -hex 16`. Needed once, then the accounts are the login.
ANYTHINGLLM_AUTH_TOKEN=
# Opens the gateway's internal llm listener for the worker only; the gateway swaps it for the
# provider's key. Random, e.g. `openssl rand -hex 32`.
LLM_INTERNAL_KEY=
