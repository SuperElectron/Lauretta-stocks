{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__langgraph-docs__list_doc_sources",
      "mcp__langgraph-docs__fetch_docs"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.bak*)",
      "Read(./.env.*.local)",
      "Read(./.env.prod*)",
      "Read(./.env.spark*)",
      "Read(./.env.dev*)",
      "Read(./.env.staging*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  }
}
